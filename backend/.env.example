# ══════════════════════════════════════════════════════════════════
# PRAGATI Backend — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════════

PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/pragati
# Production (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/pragati?retryWrites=true&w=majority

# ── JWT (IMPORTANT: use 4h not 15m — prevents SkillPath timeout) ─
JWT_SECRET=generate_64char_hex_here
JWT_REFRESH_SECRET=generate_different_64char_hex_here
JWT_EXPIRES_IN=4h
JWT_REFRESH_EXPIRES_IN=30d

# ── Cloudinary (resume/file storage) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── AI Keys ───────────────────────────────────────────────────────
# Groq (PRIMARY — fast, free 14,400 req/day)
# Get key: https://console.groq.com → API Keys
GROQ_API_KEY=your_groq_api_key_here

# Gemini (FALLBACK — free 15 req/min)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIza_your_gemini_key_here

# ── ML Service (SkillPath resume analysis) ────────────────────────
ML_SERVICE_URL=https://your-ml-service.onrender.com

# ── CORS ──────────────────────────────────────────────────────────
FRONTEND_URL=https://your-frontend.vercel.app

# ── Misc ──────────────────────────────────────────────────────────
NODE_ENV=production
BCRYPT_SALT_ROUNDS=12
