# ══════════════════════════════════════════════════════════════════
# PRAGATI Backend — Environment Variables
# NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════════

PORT=5000

# ── MongoDB ───────────────────────────────────────────────────────
MONGODB_URI=your_mongo_uri


# ── JWT (IMPORTANT: use 4h not 15m — prevents SkillPath timeout) ─
JWT_SECRET=jwt_secrete
JWT_REFRESH_SECRET=refresh_secrete
JWT_EXPIRES_IN=4h
JWT_REFRESH_EXPIRES_IN=30d

# ── MysQL (Database) 
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASS=

# ── Cloudinary (resume/file storage) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── AI Keys ───────────────────────────────────────────────────────
# Groq (PRIMARY — fast, free 14,400 req/day)
# Get key: https://console.groq.com → API Keys
GROQ_API_KEY=

# Gemini (FALLBACK — free 15 req/min)
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ── ML Service (SkillPath resume analysis) ────────────────────────
ML_SERVICE_URL=https://pragati-ml-service.onrender.com/docs

# ── CORS ──────────────────────────────────────────────────────────
FRONTEND_URL=https://pragati-career-readiness-platform-m1gnom9w4.vercel.app/

# ── Misc ──────────────────────────────────────────────────────────
NODE_ENV=production
BCRYPT_SALT_ROUNDS=12