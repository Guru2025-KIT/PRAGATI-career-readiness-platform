# PRAGATI Frontend — Environment Variables
# Copy to .env (for local) or add to Vercel Environment Variables
# ══════════════════════════════════════════════════════════════════

# Backend API URL (no trailing slash)
REACT_APP_API_URL=https://pragati-backend-ixn3.onrender.com/api

# ML Service URL (for keepMLWarm ping — prevents Render cold starts)
REACT_APP_ML_URL=https://your-ml-service.onrender.com
